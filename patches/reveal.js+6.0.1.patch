+				/**
+				 * Enables fluid 2D panning in the overview.
+				 * An overlay captures wheel events (which don't cross iframe boundaries)
+				 * and forwards pan/click via postMessage to presentations.js in the iframe.
+				 */
+				function setupOverviewPan() {
+
+					var panX = 0, panY = 0, rafId = null;
+
+					var container = document.querySelector( '#current-slide' );
+					var overlay = document.createElement( 'div' );
+					overlay.style.cssText = 'position:absolute;inset:0;z-index:100;display:none;cursor:grab;';
+					container.appendChild( overlay );
+
+					function applyPan() {
+						rafId = null;
+						currentSlide.contentWindow.postMessage(
+							JSON.stringify( { type: 'rv-pan', x: panX, y: panY } ), '*'
