+    // Returns the 1-based flat slide number, counting through all h and v slides.
+    // Using indices.h alone always reads 0 for all-vertical presentations.
+    function getFlatSlideNumber() {
+        const indices = reveal.getIndices();
+        const hSlides = Array.from(document.querySelectorAll('.reveal .slides > section'));
+        let flat = 0;
+        for (let hi = 0; hi < indices.h; hi++) {
+            const vCount = hSlides[hi]?.querySelectorAll(':scope > section').length || 0;
+            flat += Math.max(1, vCount);
+        }
+        flat += (indices.v || 0) + 1;
+        return flat;
+    }
